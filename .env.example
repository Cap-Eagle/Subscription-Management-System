# Required
SECRET_KEY=change-me-to-a-long-random-string
# SQLite for local development; use e.g. postgresql+psycopg://user:pass@host/dbname in production
DATABASE_URL=sqlite:///./app.db

# Password-reset email (if SMTP_HOST is empty, no email is sent)
FRONTEND_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
